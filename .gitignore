# ==========================================
# WorkSphere HR - Git Ignore Rules
# ==========================================

# Byte-compiled / optimized / cached files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.c
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Streamlit specific
# Allow .streamlit/config.toml if customized, but ignore secrets and logs
.streamlit/secrets.toml
.streamlit/*.log

# Local Database files (SQLite)
*.db
*.sqlite
*.sqlite3
worksphere.db

# Environment variables & local secrets
.env
.env.local
.env.*.local
*.env

# IDEs & Code Editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs & Exported Reports
*.log
*.csv
!examples/*.csv
*.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
